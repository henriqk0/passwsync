<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/settings_title"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/reset_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/settings_reset" />

        <EditText
            android:id="@+id/auto_lock_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auto_lock_minutes"
            android:inputType="number"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/clipboard_clear_seconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/clipboard_clear_seconds"
            android:inputType="number"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/sync_interval_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sync_interval_minutes"
            android:inputType="number"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/device_name"
            android:inputType="text|textNoSuggestions"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />

        <TextView
            android:id="@+id/restart_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/restart_required" />

        <Button
            android:id="@+id/restart_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restart_now" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="?android:attr/colorError" />
    </LinearLayout>
</ScrollView>
