# Pinned inputs of the Rust Android build (research R1, R16, R18). Read by
# android/build-rust.sh on a host with rustup and the NDK; not used by Gradle.
# NDK r28c (LTS); the revision is checked against source.properties of the NDK.
NDK_REVISION=28.2.13676358
ANDROID_MIN_API=33
RUST_TARGETS="aarch64-linux-android x86_64-linux-android"
# jniLibs ABI directory for each target, in the same order.
ANDROID_ABIS="arm64-v8a x86_64"
CRATE=passwsync-ffi
LIBRARY=libpasswsync_ffi.so
