<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/unlock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unlock_title" />

    <TextView
        android:id="@+id/password_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/master_password"
        android:text="@string/master_password" />

    <EditText
        android:id="@+id/master_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/master_password"
        android:inputType="textPassword|textNoSuggestions"
        android:imeOptions="actionDone|flagNoPersonalizedLearning"
        android:importantForAutofill="noExcludeDescendants" />

    <EditText
        android:id="@+id/search_query"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search"
        android:inputType="text" />

    <Button
        android:id="@+id/unlock_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unlock" />

    <ImageButton
        android:id="@+id/lock_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/lock_all" />
</LinearLayout>
